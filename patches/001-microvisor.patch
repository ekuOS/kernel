+++ b/security/microvisor/Kconfig
@@ -0,0 +1,19 @@
+# SPDX-License-Identifier: GPL-2.0-only
+config SECURITY_MICROVISOR
+	bool "Microvisor application data protection"
+	depends on SECURITY && RUST && MULTIUSER
+	select EXT4_FS_SECURITY if EXT4_FS
+	help
+	  Use security.microvisor inode xattrs to label browser executables
+	  and their data independently of Unix ownership. See the
+	  overlay README before enabling microvisor in the active LSM list.
+
+config MICROVISOR_PTRACE
+	bool "Restrict ptrace access to protected applications"
+	depends on SECURITY_MICROVISOR
+	default y
+
+config MICROVISOR_FD
+	bool "Restrict use of descriptors opened by protected applications"
+	depends on SECURITY_MICROVISOR
+	default y
